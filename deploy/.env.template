# =============================================================================
# YAGMCP Server Configuration
# Copy to .env and adjust values for your environment.
# =============================================================================

TZ=America/New_York

# OpenAI-compatible LLM backend (vLLM / NIM).
# The "/v1" suffix is optional. Leave LLM_API_KEY empty when the server runs
# without --api-key.
LLM_BASE_URL=http://192.168.0.25:8001/v1
LLM_MODEL=RedHatAI/Llama-4-Maverick-17B-128E-Instruct-quantized.w4a16
LLM_API_KEY=
# Per-call read timeout (seconds). Increase for large models that take >180s
# with big context payloads.
LLM_TIMEOUT_SECONDS=300
# Cap on generated tokens per call.
LLM_MAX_TOKENS=2048

# Ghidra repos — host path to mount into the container as /repos.
# Must match the repos directory used by your Ghidra server.
# Examples:
#   REPOS_HOST_DIR=./repos                  (local, default)
#   REPOS_HOST_DIR=/mnt/nas/Ghidra Work     (NAS-backed Ghidra server)
REPOS_HOST_DIR=./repos

# Container-side repos path (no need to change)
REPOS_DIR=/repos

# Project cache
MAX_CACHED_PROGRAMS=5

# Server
GHIDRA_ASSIST_PORT=8889
LOG_LEVEL=INFO
